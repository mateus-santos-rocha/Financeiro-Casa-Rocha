# Supabase (frontend pode usar ANON; SERVICE_ROLE só no server/Actions)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: dono/repo no GitHub p/ link fallback do botão "Atualizar"
NEXT_PUBLIC_GITHUB_REPO=seu-usuario/seu-repo

# Botão "↻ Atualizar" 1-clique (server-only, Vercel Env + local .env.local, nunca NEXT_PUBLIC_):
# - Crie um fine-grained PAT com acesso ao repo e permissão Actions: write
# - GITHUB_REPO precisa ser owner/repo (pode repetir o valor acima)
GITHUB_TOKEN=
GITHUB_REPO=seu-usuario/seu-repo
# Opcionais (defaults: sync.yml / main)
# GITHUB_WORKFLOW=sync.yml
# GITHUB_REF=main

# Pluggy — 1 par por CPF/Meu Pluggy (começa só com _1; esposa entra como _2 depois)
PLUGGY_CLIENT_ID_1=
PLUGGY_CLIENT_SECRET_1=
PLUGGY_CLIENT_ID_2=
PLUGGY_CLIENT_SECRET_2=
