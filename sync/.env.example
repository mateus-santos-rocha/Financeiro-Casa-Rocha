# Copie para sync/.env (SEM versionar) e preencha. Depois é só: python sync/pluggy.py
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-sb_secret-ou-service-role
PLUGGY_CLIENT_ID_1=seu-client-id-do-demo-app
PLUGGY_CLIENT_SECRET_1=seu-client-secret-do-demo-app
# Esposa (etapa 2 — conta Meu Pluggy dela, CPF dela):
# PLUGGY_CLIENT_ID_2=client-id-do-app-dela
# PLUGGY_CLIENT_SECRET_2=client-secret-do-app-dela

# Se o app não tiver permissão de listar items (erro LIST_ITEMS_FEATURE_NOT_ENABLED),
# copie os 3 itemIds do demo app (1 por banco, separados por vírgula) + bancos na mesma ordem:
# PLUGGY_ITEM_IDS_1=id-do-nubank,id-do-bb,id-do-btg
# PLUGGY_ITEM_BANKS_1=nubank,bb,btg
# Esposa (2 bancos, mesma ordem):
# PLUGGY_ITEM_IDS_2=id-do-nubank-dela,id-do-bb-dela
# PLUGGY_ITEM_BANKS_2=nubank,bb
